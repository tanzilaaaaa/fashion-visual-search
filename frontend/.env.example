# Base path/URL of the API as seen by the browser.
# Keep the default "/api": the Vite dev server (and the Vercel rewrite in
# vercel.json) proxies it to FastAPI, which keeps the session cookie first-party.
VITE_API_BASE_URL=/api
# Dev only: where the Vite proxy forwards /api (defaults to http://127.0.0.1:8000)
# API_PROXY_TARGET=http://127.0.0.1:8000
