# Copy to backend/.env for local development. Every value is optional.
ENVIRONMENT=development
MODEL_NAME=ViT-B-32-quickgelu
MODEL_PRETRAINED=openai
ARTIFACTS_DIR=./artifacts
# INDEX_PATH=./artifacts/index.faiss
# METADATA_PATH=./artifacts/metadata.json
# IMAGE_DIR=./artifacts/images
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=8
TOP_K_DEFAULT=24
RANK_ALPHA=0.85
RANK_BETA=0.15
RATE_LIMIT=60/minute
# Optional demo login (Could Have)
AUTH_ENABLED=false
DEMO_USERNAME=demo
DEMO_PASSWORD=
SESSION_SECRET=change-me
COOKIE_SECURE=false
